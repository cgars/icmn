        <mxCell id="tag" value="Identity is conserved. Meaning is negotiated." style="text;html=1;fontSize=18;align=left;fontColor=#526173;" vertex="1" parent="1"><mxGeometry x="60" y="78" width="600" height="35" as="geometry"/></mxCell>
        <mxCell id="access" value="&lt;b&gt;Access and stewardship&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526173&quot;&gt;HTTP API · steward workbench · policy context&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontSize=18;shadow=1;" vertex="1" parent="1"><mxGeometry x="575" y="145" width="600" height="105" as="geometry"/></mxCell>
        <mxCell id="sources" value="&lt;b&gt;Source domains&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526173&quot;&gt;Records remain authoritative here&lt;/font&gt;&lt;br&gt;&lt;br&gt;Finance&lt;br&gt;&lt;br&gt;Sales&lt;br&gt;&lt;br&gt;Operations&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#526173&quot;&gt;Legal entity · account · shipper&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;fontSize=18;spacing=15;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="55" y="300" width="270" height="475" as="geometry"/></mxCell>
        <mxCell id="connectors" value="&lt;b&gt;Connector boundary&lt;/b&gt;&lt;br&gt;&lt;br&gt;References, not copies&lt;br&gt;&lt;br&gt;Controlled dereferencing&lt;br&gt;&lt;br&gt;Isolated credentials" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8fafc;strokeColor=#8a99aa;strokeWidth=2;dashed=1;dashPattern=10 7;fontSize=17;spacing=16;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="370" y="300" width="205" height="475" as="geometry"/></mxCell>
        <mxCell id="identity" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b&gt;CONSERVED&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Identity plane&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526173&quot;&gt;What are we talking about?&lt;/font&gt;&lt;br&gt;&lt;br&gt;Identity registry · IMPLEMENTED&lt;br&gt;&lt;br&gt;Reference registry · IMPLEMENTED&lt;br&gt;&lt;br&gt;Match proposals · PLANNED&lt;br&gt;&lt;br&gt;Governed merge and split [PLANNED]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d8e9ff;strokeColor=#3478c9;strokeWidth=3;fontSize=18;spacing=20;verticalAlign=top;shadow=1;" vertex="1" parent="1"><mxGeometry x="625" y="300" width="410" height="475" as="geometry"/></mxCell>
        <mxCell id="meaning" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b&gt;NEGOTIATED&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Meaning plane&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526173&quot;&gt;What does it mean here and now?&lt;/font&gt;&lt;br&gt;&lt;br&gt;Assertion ledger · IMPLEMENTED&lt;br&gt;&lt;br&gt;Semantic treaties · PLANNED&lt;br&gt;&lt;br&gt;Conflict views [PLANNED]&lt;br&gt;&lt;br&gt;Finance · Sales · Operations" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f9e7ff;strokeColor=#a65cc5;strokeWidth=3;fontSize=18;spacing=20;verticalAlign=top;shadow=1;" vertex="1" parent="1"><mxGeometry x="1080" y="300" width="465" height="475" as="geometry"/></mxCell>
